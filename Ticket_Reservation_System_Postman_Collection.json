{
	"info": {
		"_postman_id": "c1f7a0b3-d64e-4e89-a651-7d9a10294e50",
		"name": "CDY2204 - Semana 3: Sistema de Gestión de Reservas con Tickets (EFS + S3)",
		"description": "Colección de pruebas para el microservicio Cloud Native de gestión de reservas y tickets. Implementa almacenamiento temporal en AWS EFS, persistencia en AWS S3 y pipeline CI/CD en EC2.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "ticketId",
			"value": "tkt-ejemplo",
			"type": "string"
		},
		{
			"key": "eventId",
			"value": "evento123",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "usuarioX",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Diagnóstico de Salud y Almacenamiento",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/tickets/health",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "health"]
				},
				"description": "Verifica el estado del microservicio, ruta montada de EFS y conectividad con AWS S3."
			},
			"response": []
		},
		{
			"name": "2. Generar Ticket (Guarda en EFS y sube automático a S3)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.ticketId) {",
							"    pm.collectionVariables.set('ticketId', jsonData.ticketId);",
							"    console.log('Ticket ID guardado: ' + jsonData.ticketId);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"eventId\": \"evento123\",\n  \"eventName\": \"Conferencia Cloud Native AWS 2026\",\n  \"userId\": \"usuarioX\",\n  \"userName\": \"Carlos Alumno Duoc\",\n  \"userEmail\": \"c.alumno@duocuc.cl\",\n  \"seatNumber\": \"A-15\",\n  \"price\": 35000.0\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/tickets/generate",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "generate"]
				},
				"description": "Genera el ticket PDF, lo almacena temporalmente en AWS EFS (/app/efs) y lo sube automáticamente a S3 en la ruta /evento123/usuarioX/ticketId.pdf"
			},
			"response": []
		},
		{
			"name": "3. Descargar Ticket por ID (Desde S3)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/tickets/{{ticketId}}/download",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "{{ticketId}}", "download"]
				},
				"description": "Descarga el archivo PDF binario del ticket directamente desde AWS S3."
			},
			"response": []
		},
		{
			"name": "4. Descargar Ticket por Evento y Usuario",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/tickets/download?eventId={{eventId}}&userId={{userId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "download"],
					"query": [
						{
							"key": "eventId",
							"value": "{{eventId}}"
						},
						{
							"key": "userId",
							"value": "{{userId}}"
						}
					]
				},
				"description": "Descarga el ticket buscando por identificador de evento y usuario."
			},
			"response": []
		},
		{
			"name": "5. Subir / Sincronizar Ticket a S3 Manualmente",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/tickets/{{ticketId}}/upload-s3",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "{{ticketId}}", "upload-s3"]
				},
				"description": "Endpoint explicito para subir o re-sincronizar un ticket desde EFS a AWS S3."
			},
			"response": []
		},
		{
			"name": "6. Modificar Detalles del Ticket (Actualiza en S3 y EFS)",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"userName\": \"Carlos Alumno Duoc (Modificado)\",\n  \"userEmail\": \"carlos.nuevo@duocuc.cl\",\n  \"seatNumber\": \"VIP-01\",\n  \"price\": 50000.0,\n  \"status\": \"CONFIRMED\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "{{ticketId}}"]
				},
				"description": "Modifica los datos del ticket, regenera el PDF y actualiza/sobrescribe el archivo en AWS S3 y EFS."
			},
			"response": []
		},
		{
			"name": "7. Consultar Historial de Tickets con Filtros",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/tickets/history?eventId={{eventId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "history"],
					"query": [
						{
							"key": "eventId",
							"value": "{{eventId}}"
						}
					]
				},
				"description": "Criterio 5 de la pauta: Consulta el historial de archivos generados permitiendo filtrar por evento, usuario o estado."
			},
			"response": []
		},
		{
			"name": "8. Reportar Estadísticas de Ventas y Reservas",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/tickets/statistics/{{eventId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "statistics", "{{eventId}}"]
				},
				"description": "Calcula y reporta total de reservas, confirmados, cancelados, recaudación total y tasa de ocupación."
			},
			"response": []
		},
		{
			"name": "9. Eliminar Ticket Específico",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "{{ticketId}}"]
				},
				"description": "Elimina el ticket del repositorio, borra el archivo de AWS S3 y el archivo temporal de EFS."
			},
			"response": []
		}
	]
}
